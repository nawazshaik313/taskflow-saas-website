# TaskFlow SaaS Platform - Environment Configuration Template
# Copy this file to .env and insert your real Gemini API key below.
# DO NOT commit real API keys to version control.

BASE_URL=https://taskflow-saas-website.onrender.com
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8080

# Authentication & Session Security
SESSION_SECRET=generate_a_secure_random_secret

# Google OAuth 2.0 Credentials (Server-side)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://taskflow-saas-website.onrender.com/api/auth/google/callback

# SMTP Email Configuration (For Password Reset Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_USE_TLS=true

